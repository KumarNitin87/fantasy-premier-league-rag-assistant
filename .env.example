# ==============================================================================
# Fantasy Football & Premier League RAG Assistant - Environment Configuration
# ==============================================================================

# Primary LLM Provider: "gemini" | "openai" | "groq" | "ollama" | "mock"
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key from: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Fallback & Offline Settings
OFFLINE_MOCK_MODE=false
FPL_SCHEDULER_MODE=embedded

# Host path mounted at /app/data by Docker Compose (set to a durable Linux disk path in deployment).
FPL_DATA_DIR=./data
FPL_IMAGE=fpl-rag-assistant:local

# Vector Store & Embedding Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=data/chroma_data
SQLITE_DB_PATH=data/fpl_historical.db

# Ingestion Settings
FPL_API_BASE_URL=https://fantasy.premierleague.com/api
NEWS_REFRESH_INTERVAL_HOURS=6
MAX_NEWS_ITEMS_PER_FEED=25
