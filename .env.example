# PL Fantasy Predictor configuration
FPL_SCHEDULER_MODE=embedded

# Optional managed Postgres URL for hosted deployment and external sync jobs.
# Leave blank for local SQLite + ChromaDB development.
DATABASE_URL=

# Host path mounted at /app/data by Docker Compose (set to a durable Linux disk path in deployment).
FPL_DATA_DIR=./data
FPL_IMAGE=pl-fantasy-predictor:local

# Vector Store & Embedding Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=data/chroma_data
SQLITE_DB_PATH=data/fpl_historical.db

# Ingestion Settings
FPL_API_BASE_URL=https://fantasy.premierleague.com/api
NEWS_REFRESH_INTERVAL_HOURS=6
MAX_NEWS_ITEMS_PER_FEED=25
