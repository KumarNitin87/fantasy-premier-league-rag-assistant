FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

COPY requirements.txt .
RUN uv pip install --system -r requirements.txt

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /home/app --create-home app \
    && mkdir -p /tmp/fpl-vercel-poc/sqlite \
        /tmp/fpl-vercel-poc/chroma \
        /tmp/fpl-vercel-poc/raw \
        /tmp/fpl-vercel-poc/home \
        /tmp/fpl-vercel-poc/huggingface \
    && chown -R 10001:10001 /tmp/fpl-vercel-poc

COPY . .

ENV HOME=/tmp/fpl-vercel-poc/home \
    HF_HOME=/tmp/fpl-vercel-poc/huggingface \
    SQLITE_DB_PATH=/tmp/fpl-vercel-poc/sqlite/fpl_historical.db \
    CHROMA_PERSIST_DIR=/tmp/fpl-vercel-poc/chroma \
    RAW_DATA_DIR=/tmp/fpl-vercel-poc/raw \
    FPL_SCHEDULER_MODE=external \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

USER 10001:10001

EXPOSE 80

CMD ["sh", "-c", "exec streamlit run app.py --server.address=0.0.0.0 --server.port=${PORT:-80}"]
